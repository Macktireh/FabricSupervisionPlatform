	partition Colors = m
		mode: import
		source =
				let
				  Source = SharePoint.Tables(SHAREPOINT_SITE_THEME_MANAGER, [Implementation = "2.0", ViewMode = "All"]),
				  #"82ca65b7-74aa-4405-8e57-47f71747569e" = Source{[Id="f20a4848-a234-4fad-b055-c629293fcf21"]}[Items],
				  RemovedOtherColumns = Table.SelectColumns(#"82ca65b7-74aa-4405-8e57-47f71747569e",{"Titre", "LightMode", "DarkMode"}),
				  RenamedColumns = Table.RenameColumns(RemovedOtherColumns,{{"Titre", "Name"}}),
				  DuplicatedColumn = Table.DuplicateColumn(RenamedColumns, "Name", "Name - Copy"),
				  SplitColumnbyDelimiter = Table.SplitColumn(DuplicatedColumn, "Name - Copy", Splitter.SplitTextByDelimiter("-", QuoteStyle.Csv), {"Category", "Shade"}),
				  ReplacedValue = Table.ReplaceValue(SplitColumnbyDelimiter, each [Category], each if Text.Contains([Category], "Gradient") then "Gradient" else [Category],Replacer.ReplaceText,{"Category"}),
