		dataType: int64
		formatString: 0
		lineageTag: 326ba44f-91cf-4df3-b528-2894ce1db663
		sourceLineageTag: max_licences
		summarizeBy: none
		sourceColumn: max_licences

		changedProperty = Description

		changedProperty = SummarizeBy

		annotation SummarizationSetBy = User

	/// Number of licenses currently in use/assigned.
