/// License dimension describing Dataiku license types, allocations (max licenses), unlimited flag, validity dates, and related metadata.
table dim_licence
	lineageTag: 803b53ed-87de-4e4b-b5fd-d33394228790
	sourceLineageTag: [gold].[dim_licence]

	/// Unique technical identifier of the license (dimension key).
	column id
		dataType: int64
		isKey
		formatString: 0
		lineageTag: 36d6d9c4-6903-41a5-bc98-a2685cc3f169
		sourceLineageTag: id
		summarizeBy: none
		sourceColumn: id

		changedProperty = Description

		annotation SummarizationSetBy = Automatic

	/// Dataiku license type (platform admin, designer, explorer…).
	column type
		dataType: string
		lineageTag: 8bad3455-6f76-4b44-8d3b-e83e31f32d00
		sourceLineageTag: type
		summarizeBy: none
		sourceColumn: type

		changedProperty = Description

		annotation SummarizationSetBy = Automatic

