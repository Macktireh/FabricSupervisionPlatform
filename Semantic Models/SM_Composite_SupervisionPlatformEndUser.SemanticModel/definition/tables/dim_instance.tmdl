/// Reference dimension for Dataiku platform instances/environments (DEV/INT/RPP/PROD) and related metadata (instance name, timestamps).
table dim_instance
	lineageTag: 433fbf91-e2bf-4cba-9e71-47b2cfe108b5
	sourceLineageTag: [gold].[dim_instance]

	/// Unique technical identifier of the license (dimension key).
	column id
		dataType: int64
		isKey
		formatString: 0
		lineageTag: 1cb9d310-27f9-482b-b621-39c01d2936fe
		sourceLineageTag: id
		summarizeBy: none
		sourceColumn: id

		changedProperty = Description

		annotation SummarizationSetBy = Automatic

